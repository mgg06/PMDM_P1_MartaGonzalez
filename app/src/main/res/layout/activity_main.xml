<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_noche">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/color_fondo_principal"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="20dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/EstiloTituloAiko"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:text="@string/app_name" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_corazon_titulo" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icono_superior"
            android:padding="10dp"
            android:src="@drawable/ic_lupa"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icono_superior"
            android:padding="10dp"
            android:src="@drawable/ic_traductor"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icono_superior"
            android:padding="10dp"
            android:src="@drawable/ic_ajustes"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="120dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- TARJETA 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_tarjeta_transparente"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/EstiloTituloAiko"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/para_mi_yo" />

                    <TextView
                        android:id="@+id/tv_fecha_1"
                        style="@style/EstiloTextoSecundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/fecha_desbloqueo"
                        tools:text="Desbloqueo: 15/05/2027" />
                </LinearLayout>

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:tint="@color/color_acento_interfaz"
                    android:src="@drawable/ic_candado" />
            </LinearLayout>

            <!-- TARJETA 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_tarjeta_transparente"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/EstiloTituloAiko"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/promesa_ano_nuevo" />

                    <TextView
                        android:id="@+id/tv_fecha_2"
                        style="@style/EstiloTextoSecundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/fecha_desbloqueo"
                        tools:text="Desbloqueo: 01/01/2028" />
                </LinearLayout>

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:tint="@color/color_acento_interfaz"
                    android:src="@drawable/ic_candado" />
            </LinearLayout>

            <!-- TARJETA 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_tarjeta_transparente"
                android:orientation="vertical"
                android:padding="24dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/EstiloTituloAiko"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/desahogo_hoy" />

                        <TextView
                            android:id="@+id/tv_fecha_3"
                            style="@style/EstiloTextoSecundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/fecha_desbloqueada"
                            tools:text="Desbloqueada: 12/03/2026" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:tint="@color/color_acento_interfaz"
                        android:src="@drawable/ic_carta" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_desahogo"
                    android:padding="16dp">

                    <TextView
                        style="@style/EstiloTextoSecundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/texto_ejemplo_aiko" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_nuevo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="28dp"
        app:backgroundTint="@color/color_acento_interfaz"
        app:tint="#FFFFFF"
        android:src="@drawable/ic_mas"
        app:shapeAppearanceOverlay="@style/EstiloFABRedondo"
        app:fabCustomSize="68dp"
        app:maxImageSize="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>