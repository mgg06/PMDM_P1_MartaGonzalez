        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/color_texto_primario</item>
        <item name="android:fontFamily">@font/londrina_solid</item>
    </style>

    <!-- Textos con Inder -->
    <style name="EstiloTextoSecundario">
